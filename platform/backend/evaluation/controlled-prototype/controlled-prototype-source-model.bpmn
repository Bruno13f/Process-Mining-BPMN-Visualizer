<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ControlledPrototypeCompact" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.26.0">
  <bpmn:collaboration id="Collaboration_ControlledPrototypeCompact">
    <bpmn:participant id="Participant_ControlledPrototype" name="Controlled Prototype Process" processRef="Process_ControlledPrototype" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ControlledPrototype" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ControlledPrototype">
      <bpmn:lane id="Lane_3" name="Lane 3">
        <bpmn:flowNodeRef>Activity_TaskD</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Lane 2">
        <bpmn:flowNodeRef>Activity_TaskE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PathJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Checkpoint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_TaskF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Lane 1">
        <bpmn:flowNodeRef>Event_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_TaskA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_TaskB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_TaskC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExclusiveJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PathDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_Start" name="Start">
      <bpmn:outgoing>Flow_Start_To_TaskA</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_TaskA" name="Task A">
      <bpmn:incoming>Flow_Start_To_TaskA</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskA_To_Decision</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Gateway A">
      <bpmn:incoming>Flow_TaskA_To_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_To_TaskB</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_To_TaskC</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_TaskB" name="Task B">
      <bpmn:incoming>Flow_Decision_To_TaskB</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskB_To_ExclusiveJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_TaskC" name="Task C">
      <bpmn:incoming>Flow_Decision_To_TaskC</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskC_To_ExclusiveJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ExclusiveJoin" name="Gateway B">
      <bpmn:incoming>Flow_TaskB_To_ExclusiveJoin</bpmn:incoming>
      <bpmn:incoming>Flow_TaskC_To_ExclusiveJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ExclusiveJoin_To_PathDecision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_PathDecision" name="Gateway C">
      <bpmn:incoming>Flow_ExclusiveJoin_To_PathDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_PathDecision_To_TaskD</bpmn:outgoing>
      <bpmn:outgoing>Flow_PathDecision_To_TaskE</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_TaskD" name="Task D">
      <bpmn:incoming>Flow_PathDecision_To_TaskD</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskD_To_PathJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_Start_To_TaskA" sourceRef="Event_Start" targetRef="Activity_TaskA" />
    <bpmn:sequenceFlow id="Flow_TaskA_To_Decision" sourceRef="Activity_TaskA" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Decision_To_TaskB" name="Option 1" sourceRef="Gateway_Decision" targetRef="Activity_TaskB" />
    <bpmn:sequenceFlow id="Flow_Decision_To_TaskC" name="Option 2" sourceRef="Gateway_Decision" targetRef="Activity_TaskC" />
    <bpmn:sequenceFlow id="Flow_TaskB_To_ExclusiveJoin" sourceRef="Activity_TaskB" targetRef="Gateway_ExclusiveJoin" />
    <bpmn:sequenceFlow id="Flow_TaskC_To_ExclusiveJoin" sourceRef="Activity_TaskC" targetRef="Gateway_ExclusiveJoin" />
    <bpmn:sequenceFlow id="Flow_ExclusiveJoin_To_PathDecision" sourceRef="Gateway_ExclusiveJoin" targetRef="Gateway_PathDecision" />
    <bpmn:sequenceFlow id="Flow_PathDecision_To_TaskD" name="Option 3" sourceRef="Gateway_PathDecision" targetRef="Activity_TaskD" />
    <bpmn:sequenceFlow id="Flow_PathDecision_To_TaskE" name="Option 4" sourceRef="Gateway_PathDecision" targetRef="Activity_TaskE" />
    <bpmn:sequenceFlow id="Flow_TaskD_To_PathJoin" sourceRef="Activity_TaskD" targetRef="Gateway_PathJoin" />
    <bpmn:sequenceFlow id="Flow_TaskE_To_PathJoin" sourceRef="Activity_TaskE" targetRef="Gateway_PathJoin" />
    <bpmn:sequenceFlow id="Flow_PathJoin_To_Checkpoint" sourceRef="Gateway_PathJoin" targetRef="Gateway_Checkpoint" />
    <bpmn:sequenceFlow id="Flow_Checkpoint_To_TaskF" sourceRef="Gateway_Checkpoint" targetRef="Activity_TaskF" />
    <bpmn:sequenceFlow id="Flow_TaskF_To_End" sourceRef="Activity_TaskF" targetRef="Event_End" />
    <bpmn:task id="Activity_TaskE" name="Task E">
      <bpmn:incoming>Flow_PathDecision_To_TaskE</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskE_To_PathJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_PathJoin" name="Gateway D">
      <bpmn:incoming>Flow_TaskD_To_PathJoin</bpmn:incoming>
      <bpmn:incoming>Flow_TaskE_To_PathJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_PathJoin_To_Checkpoint</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_Checkpoint" name="Gateway E">
      <bpmn:incoming>Flow_PathJoin_To_Checkpoint</bpmn:incoming>
      <bpmn:outgoing>Flow_Checkpoint_To_TaskF</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Activity_TaskF" name="Task F">
      <bpmn:incoming>Flow_Checkpoint_To_TaskF</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskF_To_End</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_End" name="End">
      <bpmn:incoming>Flow_TaskF_To_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ControlledPrototypeCompact">
    <bpmndi:BPMNPlane id="BPMNPlane_ControlledPrototypeCompact" bpmnElement="Collaboration_ControlledPrototypeCompact">
