        <bpmndi:BPMNLabel>
          <dc:Bounds x="509.5" y="168" width="89" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_TaskB_di" bpmnElement="Activity_TaskB">
        <dc:Bounds x="590" y="90" width="80" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_TaskC_di" bpmnElement="Activity_TaskC">
        <dc:Bounds x="590" y="200" width="80" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_ExclusiveJoin_di" bpmnElement="Gateway_ExclusiveJoin" isMarkerVisible="true">
        <dc:Bounds x="700" y="150" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="737" y="200" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PathDecision_di" bpmnElement="Gateway_PathDecision" isMarkerVisible="true">
        <dc:Bounds x="800" y="150" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="797" y="126" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_TaskD_di" bpmnElement="Activity_TaskD">
        <dc:Bounds x="930" y="465" width="80" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_TaskE_di" bpmnElement="Activity_TaskE">
        <dc:Bounds x="890" y="335" width="80" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PathJoin_di" bpmnElement="Gateway_PathJoin" isMarkerVisible="true">
        <dc:Bounds x="1025" y="340" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1022" y="316" width="55" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_TaskF_di" bpmnElement="Activity_TaskF">
        <dc:Bounds x="1125" y="335" width="80" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Fim_di" bpmnElement="Event_Fim">
        <dc:Bounds x="1237" y="347" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1245" y="383" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_CT_PrepararResolucao_di" bpmnElement="TextAnnotation_CT_PrepararResolucao">
        <dc:Bounds x="980" y="235" width="90" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_To_TaskA_di" bpmnElement="Flow_Start_To_TaskA">
        <di:waypoint x="256" y="175" />
        <di:waypoint x="310" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TaskA_To_Decision_di" bpmnElement="Flow_TaskA_To_Decision">
        <di:waypoint x="390" y="175" />
        <di:waypoint x="450" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Decision_To_TaskB_di" bpmnElement="Flow_Decision_To_TaskB">
        <di:waypoint x="475" y="150" />
        <di:waypoint x="475" y="120" />
        <di:waypoint x="590" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="473" y="93" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Decision_To_TaskC_di" bpmnElement="Flow_Decision_To_TaskC">
        <di:waypoint x="475" y="200" />
        <di:waypoint x="475" y="230" />
        <di:waypoint x="590" y="230" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="471" y="243" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TaskB_To_ExclusiveJoin_di" bpmnElement="Flow_TaskB_To_ExclusiveJoin">
        <di:waypoint x="670" y="120" />
        <di:waypoint x="725" y="120" />
        <di:waypoint x="725" y="150" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TaskC_To_ExclusiveJoin_di" bpmnElement="Flow_TaskC_To_ExclusiveJoin">
        <di:waypoint x="670" y="230" />
        <di:waypoint x="725" y="230" />
        <di:waypoint x="725" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ExclusiveJoin_To_PathDecision_di" bpmnElement="Flow_ExclusiveJoin_To_PathDecision">
        <di:waypoint x="750" y="175" />
        <di:waypoint x="800" y="175" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PathDecision_To_TaskD_di" bpmnElement="Flow_PathDecision_To_TaskD">
        <di:waypoint x="825" y="200" />
        <di:waypoint x="825" y="495" />
        <di:waypoint x="930" y="495" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="840" y="472" width="42" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PathDecision_To_TaskE_di" bpmnElement="Flow_PathDecision_To_TaskE">
        <di:waypoint x="850" y="175" />
        <di:waypoint x="930" y="175" />
        <di:waypoint x="930" y="335" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="887" y="181" width="42" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TaskD_To_PathJoin_di" bpmnElement="Flow_TaskD_To_PathJoin">
        <di:waypoint x="1010" y="495" />
        <di:waypoint x="1050" y="495" />
        <di:waypoint x="1050" y="390" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TaskE_To_PathJoin_di" bpmnElement="Flow_TaskE_To_PathJoin">
        <di:waypoint x="970" y="365" />
        <di:waypoint x="1025" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PathJoin_To_TaskF_di" bpmnElement="Flow_PathJoin_To_TaskF">
        <di:waypoint x="1075" y="365" />
        <di:waypoint x="1125" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TaskF_To_Fim_di" bpmnElement="Flow_TaskF_To_Fim">
        <di:waypoint x="1205" y="365" />
        <di:waypoint x="1237" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_CT_PrepararResolucao_di" bpmnElement="Association_CT_PrepararResolucao">
        <di:waypoint x="1015" y="275" />
        <di:waypoint x="960" y="345" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
