<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ControlledPrototypeCompact" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.28.0">
  <bpmn:collaboration id="Collaboration_ControlledPrototypeCompact">
    <bpmn:participant id="Participant_ControlledPrototype" name="Processo de Atendimento de Pedido" processRef="Process_ControlledPrototype" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ControlledPrototype" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ControlledPrototype">
      <bpmn:lane id="Lane_3" name="Avaliador Técnico">
        <bpmn:flowNodeRef>Activity_TaskD</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Gestor de Resolução">
        <bpmn:flowNodeRef>Activity_TaskE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PathJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_TaskF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Fim</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Técnico de Receção">
        <bpmn:flowNodeRef>Event_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_TaskA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_TaskB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_TaskC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ExclusiveJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PathDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Event_Start" name="Início">
      <bpmn:outgoing>Flow_Start_To_TaskA</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_TaskA" name="Receber Pedido">
      <bpmn:incoming>Flow_Start_To_TaskA</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskA_To_Decision</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Decision" name="Pedido completo?">
      <bpmn:incoming>Flow_TaskA_To_Decision</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_To_TaskB</bpmn:outgoing>
      <bpmn:outgoing>Flow_Decision_To_TaskC</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_TaskB" name="Validar Documentação">
      <bpmn:incoming>Flow_Decision_To_TaskB</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskB_To_ExclusiveJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_TaskC" name="Analisar Pedido">
      <bpmn:incoming>Flow_Decision_To_TaskC</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskC_To_ExclusiveJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_ExclusiveJoin" name="Pedido triado">
      <bpmn:incoming>Flow_TaskB_To_ExclusiveJoin</bpmn:incoming>
      <bpmn:incoming>Flow_TaskC_To_ExclusiveJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_ExclusiveJoin_To_PathDecision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_PathDecision" name="Requer parecer técnico?">
      <bpmn:incoming>Flow_ExclusiveJoin_To_PathDecision</bpmn:incoming>
      <bpmn:outgoing>Flow_PathDecision_To_TaskD</bpmn:outgoing>
      <bpmn:outgoing>Flow_PathDecision_To_TaskE</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_TaskD" name="Emitir Parecer Técnico">
      <bpmn:incoming>Flow_PathDecision_To_TaskD</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskD_To_PathJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_Start_To_TaskA" sourceRef="Event_Start" targetRef="Activity_TaskA" />
    <bpmn:sequenceFlow id="Flow_TaskA_To_Decision" sourceRef="Activity_TaskA" targetRef="Gateway_Decision" />
    <bpmn:sequenceFlow id="Flow_Decision_To_TaskB" name="Documentação completa" sourceRef="Gateway_Decision" targetRef="Activity_TaskB" />
    <bpmn:sequenceFlow id="Flow_Decision_To_TaskC" name="Análise necessária" sourceRef="Gateway_Decision" targetRef="Activity_TaskC" />
    <bpmn:sequenceFlow id="Flow_TaskB_To_ExclusiveJoin" sourceRef="Activity_TaskB" targetRef="Gateway_ExclusiveJoin" />
    <bpmn:sequenceFlow id="Flow_TaskC_To_ExclusiveJoin" sourceRef="Activity_TaskC" targetRef="Gateway_ExclusiveJoin" />
    <bpmn:sequenceFlow id="Flow_ExclusiveJoin_To_PathDecision" sourceRef="Gateway_ExclusiveJoin" targetRef="Gateway_PathDecision" />
    <bpmn:sequenceFlow id="Flow_PathDecision_To_TaskD" name="Parecer técnico" sourceRef="Gateway_PathDecision" targetRef="Activity_TaskD" />
    <bpmn:sequenceFlow id="Flow_PathDecision_To_TaskE" name="Preparar resolução" sourceRef="Gateway_PathDecision" targetRef="Activity_TaskE" />
    <bpmn:sequenceFlow id="Flow_TaskD_To_PathJoin" sourceRef="Activity_TaskD" targetRef="Gateway_PathJoin" />
    <bpmn:sequenceFlow id="Flow_TaskE_To_PathJoin" sourceRef="Activity_TaskE" targetRef="Gateway_PathJoin" />
    <bpmn:sequenceFlow id="Flow_PathJoin_To_TaskF" sourceRef="Gateway_PathJoin" targetRef="Activity_TaskF" />
    <bpmn:sequenceFlow id="Flow_TaskF_To_Fim" sourceRef="Activity_TaskF" targetRef="Event_Fim" />
    <bpmn:task id="Activity_TaskE" name="Preparar Resolução">
      <bpmn:incoming>Flow_PathDecision_To_TaskE</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskE_To_PathJoin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_PathJoin" name="Instrução concluída">
      <bpmn:incoming>Flow_TaskD_To_PathJoin</bpmn:incoming>
      <bpmn:incoming>Flow_TaskE_To_PathJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_PathJoin_To_TaskF</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_TaskF" name="Encerrar Processo">
      <bpmn:incoming>Flow_PathJoin_To_TaskF</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskF_To_Fim</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_Fim" name="Fim">
      <bpmn:incoming>Flow_TaskF_To_Fim</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="TextAnnotation_CT_PrepararResolucao">
      <bpmn:text>CT = 5 dias úteis</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_CT_PrepararResolucao" sourceRef="TextAnnotation_CT_PrepararResolucao" targetRef="Activity_TaskE" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ControlledPrototypeCompact">
    <bpmndi:BPMNPlane id="BPMNPlane_ControlledPrototypeCompact" bpmnElement="Collaboration_ControlledPrototypeCompact">
      <bpmndi:BPMNShape id="Participant_ControlledPrototype_di" bpmnElement="Participant_ControlledPrototype" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="1155" height="520" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
        <dc:Bounds x="190" y="40" width="1125" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true">
        <dc:Bounds x="190" y="300" width="1125" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true">
        <dc:Bounds x="190" y="430" width="1125" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_Start_di" bpmnElement="Event_Start">
        <dc:Bounds x="220" y="157" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="226" y="193" width="24" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_TaskA_di" bpmnElement="Activity_TaskA">
        <dc:Bounds x="310" y="145" width="80" height="60" />
